<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Apollo.Core.App"
             xmlns:Components="clr-namespace:Apollo.Components"
             xmlns:Viewers="clr-namespace:Apollo.Viewers"
             xmlns:DeviceViewers="clr-namespace:Apollo.DeviceViewers"
             Name="Apollo Studio">

  <Application.Resources>
    <FontFamily x:Key="Font">avares://Apollo/Resources#Open Sans</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <SimpleTheme />
    <StyleInclude Source="avares://Apollo/Themes/Common.xaml" />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{DynamicResource Font}" />
      <Setter Property="WindowDecorations" Value="None" />
    </Style>

    <Style Selector=":is(Control)">
      <Setter Property="Focusable" Value="false"/>
    </Style>

    <!-- Modern Avalonia also checks Focusable for explicit Focus() calls. These
         controls accept text or finish an edit by taking focus from its input. -->
    <Style Selector=":is(Window), TextBox, :is(Components|Dial), Components|MoveDial, Components|ColorPicker, Viewers|TrackInfo, Viewers|ChainInfo, DeviceViewers|FadeViewer">
      <Setter Property="Focusable" Value="true" />
      <Setter Property="KeyboardNavigation.IsTabStop" Value="false" />
    </Style>

    <Style Selector="Button">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
      <Setter Property="Background" Value="{DynamicResource ThemeControlHighBrush}" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonEnabledBrush}"/>
    </Style>

    <Style Selector="Button:pressed  /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeButtonEnabledBrush}"/>
    </Style>

    <Style Selector="CheckBox:pointerover /template/ Border#border">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonEnabledBrush}"/>
    </Style>

    <Style Selector="RadioButton:pointerover /template/ Ellipse#border">
      <Setter Property="Stroke" Value="{DynamicResource ThemeButtonEnabledBrush}"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>

    <Style Selector="ScrollBar /template/ RepeatButton.repeat">
      <Setter Property="IsVisible" Value="false" />
    </Style>

    <Style Selector="Separator">
      <Setter Property="Margin" Value="0 2" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="1" />
    </Style>
    
    <Style Selector="StackPanel.collapseAnimation">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>
  </Application.Styles>
  
  <NativeMenu.Menu>
    <NativeMenu />
  </NativeMenu.Menu>  
</Application>
